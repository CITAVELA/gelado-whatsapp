# Copiar a .env en local. En producción, estas variables van en Render (nunca en el repo).

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000            # producción: https://gelado-whatsapp.onrender.com (en dev con Vite: http://localhost:5173)
TZ=Europe/Madrid
SESSION_SECRET=                           # aleatorio, 64 caracteres
STATUS_TOKEN=                             # token para /api/status (revisión diaria)
WORKER_ENABLED=true
SEED_DEV_PASSWORD=                        # solo desarrollo: contraseña para los 3 usuarios del seed (vacío = enlaces de invitación)

# Base de datos (producción: pooler de Supabase en modo sesión, puerto 5432, ?schema=app&connection_limit=5)
DATABASE_URL=postgresql://gelado:gelado@localhost:5432/gelado?schema=app
DIRECT_URL=postgresql://gelado:gelado@localhost:5432/gelado?schema=app

# Archivos
STORAGE_DRIVER=local                      # local | supabase
LOCAL_STORAGE_DIR=./storage-local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Meta / WhatsApp Cloud API
META_GRAPH_BASE_URL=http://localhost:4010 # simulador en local; producción: https://graph.facebook.com
GRAPH_API_VERSION=v23.0                   # versión vigente al desplegar (comprobar en developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
WA_SYSTEM_USER_TOKEN=
WA_VERIFY_TOKEN=
WA_WABA_ID=24936790469294569
WA_PHONE_NUMBER_ID=833139829886325
META_BUSINESS_ID=115003938195726
