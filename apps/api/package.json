    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gelado/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/websockets": "11.1.6",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "ffmpeg-static": "5.2.0",
    "helmet": "8.1.0",
    "marked": "16.4.1",
    "multer": "2.0.2",
    "papaparse": "5.5.3",
    "pg": "8.16.3",
    "pg-boss": "10.3.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
