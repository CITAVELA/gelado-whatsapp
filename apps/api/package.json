    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.8",
    "@types/papaparse": "5.3.16",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
