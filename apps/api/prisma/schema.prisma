generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 6: DATABASE_URL = pooler de Supabase en modo sesión (puerto 5432) con ?schema=app
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ───────────── Usuarios y acceso ─────────────

enum Role {
  ADMIN
  AGENT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(AGENT)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  assignedChats     Conversation[]       @relation("Assignee")
  sentMessages      Message[]            @relation("SentBy")
  events            ConversationEvent[]
  campaignsCreated  Campaign[]           @relation("CampaignCreatedBy")
  campaignsDeclared Campaign[]           @relation("CampaignConsentBy")
  auditLogs         AuditLog[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  tokenHash String       @unique
  purpose   TokenPurpose @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TokenPurpose {
  INVITE
  RESET
}

// ───────────── Contactos ─────────────

enum ConsentStatus {
  UNKNOWN // importado sin constancia: recibe marketing salvo baja (P6)
  GRANTED // consentimiento registrado
  REVOKED // baja: nunca recibe marketing
}

enum ConsentSource {
  IMPORT
  MANUAL
  WHATSAPP_BUTTON // pulsó «No recibir más» / botón de alta
  WHATSAPP_KEYWORD // escribió BAJA / STOP
  META_ERROR_131050 // Meta indica que el usuario paró el marketing
  LEGACY_LABEL // etiqueta NO PUBLICIDAD de Superchat
  CAMPAIGN_DECLARATION
}

model Contact {
  id            String        @id @default(uuid()) @db.Uuid
  phoneE164     String        @unique // +34617498222
  waId          String?       @unique // wa_id que manda Meta
  firstName     String?
  lastName      String?
  profileName   String? // nombre de perfil de WhatsApp (solo lectura)
  email         String?
  company       String?
  customerCode  String? // «Código» de Superchat (texto para no perder ceros)
  taxId         String? // «DNI» de Superchat (DNI o CIF)
  landline      String? // «Teléfono fijo»
  notes         String?
  consentStatus ConsentStatus @default(UNKNOWN)
  consentAt     DateTime?
  phoneInvalid  Boolean       @default(false) // 131026 repetido / no tiene WhatsApp
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  labels        ContactLabel[]
  conversation  Conversation?
  consentEvents ConsentEvent[]
  campaignSends CampaignRecipient[]

  @@index([customerCode])
  @@index([taxId])
  @@index([consentStatus])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_lastName_trgm_idx")
  @@index([profileName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_profileName_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_company_trgm_idx")
  @@index([phoneE164(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phoneE164_trgm_idx")
  @@index([customerCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_customerCode_trgm_idx")
  @@index([taxId(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_taxId_trgm_idx")
}

model ConsentEvent {
  id        String        @id @default(uuid()) @db.Uuid
  contactId String        @db.Uuid
  status    ConsentStatus
  source    ConsentSource
  note      String?
  userId    String?       @db.Uuid
  messageId String?       @db.Uuid
  createdAt DateTime      @default(now())
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

enum LabelScope {
  CONTACT // tipo de cliente: PELUQUERÍA, BARBERÍA, ESTÉTICA…
  CONVERSATION // tema: PEDIDO, FACTURA, TRANSPORTE…
}

model Label {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  color           String // hex
  scope           LabelScope
  showAsInboxView Boolean    @default(false) // aparece como «bandeja» en el menú lateral
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())

  contacts      ContactLabel[]
  conversations ConversationLabel[]

  @@unique([name, scope])
}

model ContactLabel {
  contactId String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
}

// ───────────── Bandeja ─────────────

enum ConversationStatus {
  OPEN
  SNOOZED
  DONE
}

model Conversation {
  id                   String             @id @default(uuid()) @db.Uuid
  contactId            String             @unique @db.Uuid
  status               ConversationStatus @default(OPEN)
  snoozedUntil         DateTime?
  assigneeId           String?            @db.Uuid
  starred              Boolean            @default(false)
  unreadCount          Int                @default(0)
  lastMessageAt        DateTime?
  lastMessagePreview   String?
  lastMessageKind      MessageKind?
  lastMessageDirection MessageDirection?
  lastInboundAt        DateTime? // abre/renueva la ventana de 24 h
  windowExpiresAt      DateTime? // lastInboundAt + 24 h
  lastAutoReplyAt      DateTime? // fuera de horario / vacaciones
  lastCampaignId       String?            @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  contact  Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee User?               @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]
  events   ConversationEvent[]
  labels   ConversationLabel[]

  @@index([status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([snoozedUntil])
}

model ConversationLabel {
  conversationId String       @db.Uuid
  labelId        String       @db.Uuid
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL // nota interna: nunca sale a WhatsApp
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
  VOICE
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  BUTTON_REPLY // respuesta a botón de plantilla o interactivo
  REACTION
  TEMPLATE
  AUTO_REPLY // fuera de horario / vacaciones
  NOTE
  UNSUPPORTED
}

enum MessageStatus {
  RECEIVED // entrante
  PENDING // en cola para enviar
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  direction         MessageDirection
  kind              MessageKind
  body              String? // texto o pie de foto
  mediaId           String?          @db.Uuid
  templateId        String?          @db.Uuid
  templateParams    Json? // valores enviados en cada componente
  payload           Json? // ubicación, contactos, botón pulsado, reacción…
  wamid             String?          @unique
  contextWamid      String? // mensaje citado
  status            MessageStatus
  errorCode         Int?
  errorTitle        String?
  errorDetails      String?
  sentOutsideWindow Boolean          @default(false) // cuenta para el límite de 24 h
  pricingCategory   String? // marketing, utility, service… (de los estados de Meta)
  billable          Boolean?
  sentById          String?          @db.Uuid
  campaignId        String?          @db.Uuid
  receivedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  raw               Json? // objeto original de Meta (entrantes)
  createdAt         DateTime         @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  media        MediaFile?         @relation(fields: [mediaId], references: [id])
  template     Template?          @relation(fields: [templateId], references: [id])
  sentBy       User?              @relation("SentBy", fields: [sentById], references: [id], onDelete: SetNull)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id])
  recipient    CampaignRecipient?

  @@index([conversationId, createdAt])
  @@index([campaignId])
  @@index([direction, kind, sentAt])
  @@index([sentOutsideWindow, createdAt]) // uso del límite de 24 h (campañas, calidad)
}

enum ConversationEventType {
  ASSIGNED
  UNASSIGNED
  SNOOZED
  WOKE_UP
  DONE
  REOPENED
  LABEL_ADDED
  LABEL_REMOVED
  STARRED
  UNSTARRED
  CONSENT_CHANGED
}

model ConversationEvent {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @db.Uuid
  type           ConversationEventType
  actorId        String?               @db.Uuid // null = sistema
  data           Json?
  createdAt      DateTime              @default(now())
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ───────────── Archivos ─────────────

enum MediaSource {
  INBOUND
  UPLOAD
  LIBRARY
  TEMPLATE_EXAMPLE
}

model MediaFile {
  id                 String      @id @default(uuid()) @db.Uuid
  storagePath        String      @unique
  mimeType           String
  sizeBytes          Int
  fileName           String?
  sha256             String?
  source             MediaSource
  waMediaId          String? // id en WhatsApp para reutilizar
  waMediaIdExpiresAt DateTime?
  createdById        String?     @db.Uuid
  createdAt          DateTime    @default(now())

  messages     Message[]
  libraryFiles LibraryFile[]
}

model LibraryFolder {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?         @db.Uuid
  sortOrder Int             @default(0)
  parent    LibraryFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  LibraryFolder[] @relation("FolderTree")
  files     LibraryFile[]
}

model LibraryFile {
  id          String         @id @default(uuid()) @db.Uuid
  folderId    String?        @db.Uuid
  name        String // «DOUSSE Carta de Color»
  mediaFileId String         @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  folder      LibraryFolder? @relation(fields: [folderId], references: [id])
  media       MediaFile      @relation(fields: [mediaFileId], references: [id])
}

// ───────────── Plantillas y campañas ─────────────

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  LOCAL_DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  IN_APPEAL
  DELETED
}

model Template {
  id              String           @id @default(uuid()) @db.Uuid
  metaTemplateId  String?          @unique
  name            String // nombre en Meta (minúsculas y _)
  displayName     String? // nombre interno legible
  language        String // es
  category        TemplateCategory
  status          TemplateStatus
  components      Json // HEADER/BODY/FOOTER/BUTTONS tal cual Meta
  rejectedReason  String?
  qualityScore    String?
  hasOptOutButton Boolean          @default(false)
  lastSyncedAt    DateTime?
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  messages  Message[]
  campaigns Campaign[]

  @@unique([name, language])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model Campaign {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  templateId          String         @db.Uuid
  variableMapping     Json // { "body.1": { "field": "firstName", "fallback": "cliente" }, … }
  headerMediaId       String?        @db.Uuid
  audience            Json // { includeLabelIds: [], excludeLabelIds: [], includeUnknownConsent: false }
  status              CampaignStatus @default(DRAFT)
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  ratePerMinute       Int            @default(20)
  stopReason          String?
  consentDeclared     Boolean        @default(false)
  consentDeclaredById String?        @db.Uuid
  consentDeclaredAt   DateTime?
  estimatedCost       Decimal?       @db.Decimal(10, 4)
  currency            String         @default("EUR")
  totalRecipients     Int            @default(0)
  sentCount           Int            @default(0)
  deliveredCount      Int            @default(0)
  readCount           Int            @default(0)
  repliedCount        Int            @default(0)
  failedCount         Int            @default(0)
  skippedCount        Int            @default(0)
  optOutCount         Int            @default(0)
  createdById         String         @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  template   Template            @relation(fields: [templateId], references: [id])
  createdBy  User                @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  consentBy  User?               @relation("CampaignConsentBy", fields: [consentDeclaredById], references: [id])
  recipients CampaignRecipient[]
  messages   Message[]

  @@index([status, scheduledAt])
}

enum RecipientStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model CampaignRecipient {
  id          String          @id @default(uuid()) @db.Uuid
  campaignId  String          @db.Uuid
  contactId   String          @db.Uuid
  phoneE164   String // copia en el momento del envío
  status      RecipientStatus @default(QUEUED)
  skipReason  String? // REVOKED, UNKNOWN_CONSENT, PHONE_INVALID, DAILY_LIMIT, DUPLICATE
  plannedFor  DateTime? // tanda / día previsto
  claimedAt   DateTime? // cuándo pasó a SENDING (para devolver a la cola los huérfanos)
  messageId   String?         @unique @db.Uuid
  errorCode   Int?
  errorTitle  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?
  optedOutAt  DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId, sentAt]) // respuestas y bajas de campaña por contacto
}

// ───────────── Sistema ─────────────

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  receivedAt     DateTime  @default(now())
  signatureValid Boolean
  field          String? // messages, message_template_status_update…
  dedupeKey      String?   @unique // wamid+status, id de evento…
  payload        Json
  processedAt    DateTime?
  attempts       Int       @default(0)
  error          String?

  @@index([processedAt])
  @@index([receivedAt]) // último webhook recibido (calidad, /api/status) y limpieza diaria
}

model QualitySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  qualityRating  String // GREEN, YELLOW, RED, UNKNOWN
  messagingLimit String?
  phoneStatus    String?
  source         String // POLL | WEBHOOK
  raw            Json?
  createdAt      DateTime @default(now())
}

model Setting {
  key         String   @id // business_hours, out_of_hours, vacation, rates, campaign_defaults, privacy_policy
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

/// Lista de supresión mínima (RGPD + «un dado de baja nunca recibe marketing»): al borrar físicamente un contacto se
/// guarda aquí solo el HMAC-SHA256 de su teléfono E.164 (clave = SESSION_SECRET). Si el número vuelve (importación,
/// mensaje entrante o alta manual) el contacto nuevo nace REVOKED con origen MANUAL y nota «Suprimido previamente».
model SuppressedPhone {
  phoneHash String   @id
  createdAt DateTime @default(now())
}

model ImportJob {
  id            String    @id @default(uuid()) @db.Uuid
  fileName      String
  mediaFileId   String    @db.Uuid
  mapping       Json?
  status        String // UPLOADED, PREVIEWED, RUNNING, DONE, FAILED
  options       Json?
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  created       Int       @default(0)
  updated       Int       @default(0)
  skipped       Int       @default(0)
  errors        Json? // [{ row, reason }]
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String // export_contacts, launch_campaign, delete_contact…
  entityType String?
  entityId   String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum AlertLevel {
  WARNING
  CRITICAL
}

/// Avisos visibles en el banner (RF-6.2). Activos mientras resolvedAt sea null.
model Alert {
  id         String     @id @default(uuid()) @db.Uuid
  kind       String // quality, phone_flagged, template_paused, account, sending_stopped, webhook_stale
  level      AlertLevel
  message    String
  dedupeKey  String?    @unique // p. ej. template_paused:<templateId>
  data       Json?
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
}
